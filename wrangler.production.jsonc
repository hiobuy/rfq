// Configuration of the hosted HIOBuy RFQ demo (https://rfq.demo.hiobuy.com), without secrets.
// Secrets: `wrangler secret put HIOBUY_API_KEY` and `wrangler secret put HIOBUY_WEBHOOK_SECRET`.
// For your own deployment, copy wrangler.jsonc instead.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiobuy-rfq-demo",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
  "vars": {
    "PUBLIC_ORIGIN": "https://rfq.demo.hiobuy.com",
    "HIOBUY_GATEWAY_ORIGIN": "https://api.hiobuy.com",
    "DEMO_REF_PREFIX": "demo-",
    "DEMO_MODE": "true"
  },
  "durable_objects": { "bindings": [{ "name": "DEMO_STATE", "class_name": "DemoState" }] },
  "migrations": [{ "tag": "v1-demo-state", "new_sqlite_classes": ["DemoState"] }],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
  "routes": [{ "pattern": "rfq.demo.hiobuy.com", "zone_name": "hiobuy.com", "custom_domain": true }],
  "services": [{ "binding": "HIOBUY_GATEWAY", "service": "hiobuy-api-gateway" }]
}
