// Example Cloudflare Workers configuration. NOT deployed; a hosted demo needs a separate decision.
// Secrets: `wrangler secret put HIOBUY_API_KEY` and `wrangler secret put HIOBUY_WEBHOOK_SECRET`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rfq-demo-dev",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
  "vars": { "PUBLIC_ORIGIN": "https://rfq-demo.example.com", "HIOBUY_GATEWAY_ORIGIN": "https://api.hiobuy.com", "DEMO_REF_PREFIX": "demo-", "DEMO_MODE": "true" },
  "durable_objects": { "bindings": [{ "name": "DEMO_STATE", "class_name": "DemoState" }] },
  "migrations": [{ "tag": "v1-demo-state", "new_sqlite_classes": ["DemoState"] }],
  "observability": { "enabled": true }
}
